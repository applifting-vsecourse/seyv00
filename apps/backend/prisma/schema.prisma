// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  // Prisma 7's modern generator. The client is written into src/ as ordinary
  // generated source instead of being injected into node_modules, so it
  // survives dependency pruning and multi-stage Docker copies.
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  admin

  @@map("user_role")
}

enum QuackMood {
  happy
  sad
  angry
  silly

  @@map("quack_mood")
}

model Quack {
  id          String       @id @default(cuid())
  // NULL only on a placeholder for a deleted quack that still has replies
  text        String?      @db.Text
  mood        QuackMood?
  // NULL only on a placeholder. Deleting an account deletes its live quacks,
  // and fails (see parent) while one of them still has someone's replies.
  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt
  // set when a quack with replies was deleted: text, mood, author and poll are gone.
  // The migration's quack_placeholder_check keeps a placeholder all-or-nothing.
  deletedAt   DateTime?
  // a quack with a parent is a reply; replies are one level deep (checked in the service).
  // NoAction: the database refuses to hard-delete a quack that has replies, checked at
  // the end of the statement so an account's own replies can cascade away with it.
  parent      Quack?       @relation("QuackReplies", fields: [parentId], references: [id], onDelete: NoAction)
  parentId    String?
  replies     Quack[]      @relation("QuackReplies")
  // a quack with answers is a poll; the quack text is its question
  pollOptions PollOption[]
  pollVotes   PollVote[]

  @@index([userId])
  // the replies of a thread, oldest first
  @@index([parentId, createdAt])
  @@map("quack")
}

model PollOption {
  id       String     @id @default(cuid())
  quack    Quack      @relation(fields: [quackId], references: [id], onDelete: Cascade)
  quackId  String
  text     String     @db.VarChar(50)
  // the order the author typed the answers in
  position Int
  votes    PollVote[]

  @@unique([quackId, position])
  // target of PollVote's composite foreign key
  @@unique([id, quackId])
  @@map("poll_option")
}

model PollVote {
  quack     Quack      @relation(fields: [quackId], references: [id], onDelete: Cascade)
  quackId   String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  // (optionId, quackId) together: a vote can only point at an answer of its own poll
  option    PollOption @relation(fields: [optionId, quackId], references: [id, quackId], onDelete: Cascade)
  optionId  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt

  // one person, one vote per poll — enforced by the database, not just the app
  @@id([quackId, userId])
  @@index([optionId])
  @@index([userId])
  @@map("poll_vote")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @db.VarChar(255)
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  issuer                String?
  password              String?   @db.Text
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model User {
  id            String     @id
  name          String
  email         String
  emailVerified Boolean
  image         String?    @db.Text
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  quacks        Quack[]
  pollVotes     PollVote[]
  role          UserRole   @default(user)

  username        String? @db.VarChar(50)
  displayUsername String? @db.VarChar(50)

  bio         String?    @db.VarChar(160)
  // preselected in the new-quack form
  defaultMood QuackMood?

  @@unique([email])
  @@unique([username])
  @@map("user")
}
